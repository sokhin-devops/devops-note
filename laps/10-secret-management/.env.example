# Copy to .env. Only one real value here — everything Vault manages from
# here on lives inside Vault, not in a file like this one.
#
#   cp .env.example .env

# Bootstrap password for the Postgres admin role. Something has to start
# this chain outside of Vault — this is that one thing. Once containers
# are up, this exact password is also what gets stored as the KV secret in
# ./01-kv-secrets.sh, so the app container's Vault-fetched credentials are
# real, working Postgres credentials.
POSTGRES_ADMIN_PASSWORD=change-this-before-first-run

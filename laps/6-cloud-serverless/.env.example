# Copy to .env and fill in. .env is gitignored — never commit your token.
#
#   cp .env.example .env
#
# Create a token at: https://dash.cloudflare.com/profile/api-tokens
# Use "Create Custom Token" with these permissions:
#   Account | Workers Scripts       | Edit
#   Account | Workers KV Storage    | Edit
#   Account | Workers Routes        | Edit   (also under "Workers Scripts" in the UI)
#   Zone    | Zone                  | Edit
#   Zone    | DNS                   | Edit
# Zone Resources: Specific zone -> sokhin.site (once the zone exists; until
# then use "All zones from an account" for the first run, then narrow it).
CLOUDFLARE_API_TOKEN=

# Leave empty to auto-detect from the token (needs Account:Read on the token,
# which the Workers/Zone edit permissions above already imply for most
# accounts). Set it explicitly if 01-check.sh finds more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Your Hostinger-registered domain
LAB_DOMAIN=sokhin.site

# Subdomain the Worker is served on: __LAB_DOMAIN__ becomes edge.sokhin.site.
# The root domain and its existing A record are never touched by this lab.
WORKER_SUBDOMAIN=edge

# Name of the Worker script on Cloudflare
WORKER_NAME=devops-lab-edge

# Copy to .env and fill in. .env is gitignored — never commit your API key.
#
#   cp .env.example .env
#
# Create a key at: https://my.vultr.com/settings/#settingsapi
# Vultr also restricts API access by IP — add your current public IP to the
# allowed list on that page, or every call returns 403.
VULTR_API_KEY=

# Region. sgp = Singapore, the closest Vultr region to Cambodia.
# Run ./01-check.sh to list every region.
VULTR_REGION=sgp

# Plan (the VM size). vc2-1c-1gb is the smallest general-purpose plan.
# ./01-check.sh prints the plans available in your region with their prices.
VULTR_PLAN=vc2-1c-1gb

# Which OS to install. Matched by name against GET /v2/os.
VULTR_OS_NAME="Ubuntu 24.04 LTS x64"

# Label/hostname for the VM, and the name of the firewall group
LAB_LABEL="devops-lab"

# The public key uploaded to Vultr and installed on the VM.
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub

# The matching private key used by ssh/scp in 04, 05 and 06
SSH_PRIVATE_KEY=~/.ssh/id_ed25519

# Copy to .env and fill in. .env is gitignored — never commit your API key.
#
#   cp .env.example .env
#
# This is the ONE secret this lab has, and it never goes in a .tfvars file —
# the Vultr provider reads it directly from this environment variable, so
# it's never written into any Terraform file, state, or plan. That's the
# real answer to the lesson's "don't commit secrets in tfvars" warning: for
# a value the provider itself can read from the environment, don't make it
# a Terraform variable at all.
VULTR_API_KEY=

# Used only by 03-apply.sh and 04-verify.sh (plain ssh/scp, outside of
# Terraform) to wait for cloud-init and check the deployed app. Terraform
# itself reads the *public* key straight from disk — see
# environments/dev.tfvars.
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
